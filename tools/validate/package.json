{
  "name": "@interstage/validate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository validator for Interstage plugins, skills and manifests.",
  "scripts": {
    "validate": "bun run src/cli.ts ../..",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "nx": {
    "implicitDependencies": ["interstage"],
    "targets": {
      "validate": {
        "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/.omp-plugin/**/*", "{workspaceRoot}/skills.manifest.json", "{workspaceRoot}/THIRD_PARTY_NOTICES.md"]
      }
    }
  }
}
