{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/package.json"]
  },
  "targetDefaults": {
    "validate": {
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/tools/validate/src/**/*", "{workspaceRoot}/skills.manifest.json"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default"]
    },
    "test": {
      "cache": true,
      "inputs": ["default"]
    }
  }
}
